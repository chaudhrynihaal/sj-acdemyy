# ─────────────────────────────────────────────────────────────
# SJ Academy — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is gitignored). Only this example is tracked.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Project URL and the PUBLIC anon key (safe to expose to the browser).
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# NOTE: Do NOT put the service_role key here or anywhere in this app —
# it bypasses Row Level Security and must never reach the client.

# ── Site (recommended) ───────────────────────────────────────
# Canonical production URL, used to build absolute links in emails.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# WhatsApp number in E.164 (used by the floating button / fee buttons).
NEXT_PUBLIC_WHATSAPP_E164=+923002029179

# ── Email notifications (required for lead/testimonial alerts) ─
# Where owner notifications are sent. Comma-separated for multiple.
OWNER_EMAIL=owner@your-domain.com
# Verified "from" address (must be a domain verified in Resend).
EMAIL_FROM=SJ Academy <noreply@your-domain.com>

# Primary email provider: Resend API key.
RESEND_API_KEY=re_your_resend_key

# Optional SMTP (Gmail) fallback if you prefer SMTP over Resend.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
